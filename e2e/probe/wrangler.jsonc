{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "noha-pearls-probe",
  "main": "../../src/server/testing/probeWorker.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "../../dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "ProbedHub" }]
  },
  "exports": { "ProbedHub": { "type": "durable-object", "storage": "sqlite" } }
}
