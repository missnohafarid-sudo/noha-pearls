#!/bin/sh
# A push to main (the maintainer's direct push) must pass the whole check first.
# A push to any other branch, the `try` branch that `npm run ship` uses, passes without one: GitHub runs the whole check
# on it before the change can reach main.
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ] && ! npm run check </dev/null; then
    echo ""
    echo "PUSH BLOCKED: the check failed, so nothing was sent. Fix what it says, then push again."
    exit 1
  fi
done
